# Copy to .env.local (local) or set in your hosting provider's environment settings.
# Never commit real secrets. Only NEXT_PUBLIC_* values reach the browser.

# Public site URL — canonical links, Open Graph and links inside order messages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Orders (SERVER ONLY — no NEXT_PUBLIC_ prefix!) ----------------------------
# Google Apps Script web app URL (Deploy → Manage deployments → Web app URL).
# Also serves live catalog content and uploads. See google-apps-script/CATALOG-SETUP.md.
# Use a TEST spreadsheet's deployment while developing.
APPS_SCRIPT_ORDER_URL=
# Shared secret; must equal the APPS_SCRIPT_SECRET Script Property. At least 16 characters,
# e.g. generate with: node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
APPS_SCRIPT_SECRET=

# Delivery charges in whole taka (digits only). Blank uses the published store rates.
DELIVERY_CHARGE_INSIDE_DHAKA=80
DELIVERY_CHARGE_OUTSIDE_DHAKA=140

# ---- Internal admin (SERVER ONLY) ---------------------------------------------
# All three are required. Blank values keep admin access disabled.
ADMIN_USERNAME=
# At least 12 characters. Use a strong, unique password.
ADMIN_PASSWORD=
# Random signing secret, at least 32 characters. Rotate to invalidate all sessions.
ADMIN_SESSION_SECRET=
